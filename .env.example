HTTP_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

DATABASE_URL=postgres://postgres:postgres@localhost:5432/tripgo
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s
DATABASE_MAX_CONN_LIFETIME=1h

HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

OTEL_SERVICE_NAME=trip-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:22318
DOCKER_OTEL_EXPORTER_OTLP_ENDPOINT=http://tripgo-local-control-plane:30206
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on

POSTGRES_PASSWORD=password
